{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GoXLR Studio",
  "version": "0.1.0",
  "identifier": "io.github.mrdonnii.goxlrstudio",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GoXLR Studio",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#0b0f17",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
